# Market Hub 后端环境变量示例
# 复制本文件为 .env 并填入实际值（.env 已被 .gitignore 排除，不会提交）

# ---------- 数据库 ----------
MH_DB_HOST=127.0.0.1
MH_DB_PORT=3307
MH_DB_USER=mkt
MH_DB_PASS=change-me
MH_DB_NAME=market_hub

# ---------- 服务 ----------
MH_API_HOST=0.0.0.0
MH_API_PORT=8090

# ---------- 鉴权（生产环境务必改成随机长字符串） ----------
MH_JWT_SECRET=change-me-to-a-long-random-string
MH_JWT_EXPIRE_HOURS=72

# ---------- 采集 ----------
# 单源请求最小间隔（秒）—— 防封核心，不要调低
MH_MIN_INTERVAL=1.5
MH_REQ_TIMEOUT=12
# 强行走 IPv4（服务器若无 IPv6 出口，必须置 1）
MH_FORCE_IPV4=1

# ---------- 定时任务 ----------
MH_SNAPSHOT_INTERVAL=5

# ---------- 初始管理员（首次初始化时使用） ----------
MH_ADMIN_USER=admin
MH_ADMIN_PASS=change-me
